---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
---

<BaseLayout 
    title="首頁 | Astro 練習" 
    url="https://astro.com" 
    ogImage="https://astro.com/og-image.png" 
    ogTitle="Astro 練習" 
    ogDescription="用 Astro 建立快速、內容導向的網站。"
    ogUrl="https://astro.com"
>
  <section class="hero">
    <h1>歡迎來到 Astro 練習</h1>
    <p>用 Astro 建立快速、內容導向的網站。</p>
    <a class="btn" href="/blog">查看文章</a>
  </section>

  <section class="cards">
    <Card
      title="零 JS 預設"
      description="Astro 預設不傳送任何 JavaScript，讓網站載入飛快。"
    />
    <Card
      title="Islands 架構"
      description="只在需要互動的地方注入 JS，其餘保持靜態。"
    />
    <Card
      title="支援多框架"
      description="可同時使用 React、Vue、Svelte 等框架元件。"
    />
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 4rem 0;
  }

  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: #7c3aed;
  }

  .btn {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.75rem 1.5rem;
    background: #7c3aed;
    color: white;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
  }

  .btn:hover {
    background: #6d28d9;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }
</style>
